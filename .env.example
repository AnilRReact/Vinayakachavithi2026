VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional. Needed only for the Ask a question feature when deployed behind a serverless proxy.
VITE_AI_ENDPOINT=/api/ask
# Server-only Vercel setting; never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Phase 3 Web Push (VAPID) keys; public key is safe in the client, private stays server-side.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:committee@example.com
CRON_SECRET=use-a-long-random-secret
