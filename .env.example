VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google AI (Gemini) API Key for the Festival Guide Chatbot (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Optional: Anthropic Claude Key (alternative AI provider)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only Vercel settings; never prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 3 Web Push (VAPID) keys; public key is safe in the client, private stays server-side.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:committee@example.com
CRON_SECRET=use-a-long-random-secret
