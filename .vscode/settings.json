{
  "git.autorefresh": false,
  "git.autoStash": true,
  "git.showProgress": false,
  "git.autofetch": false,
  "git.confirmSync": false,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  }
}
